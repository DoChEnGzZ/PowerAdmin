<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chengnianzhi.poweradmin_api.repository.RolePermissionMapper">
    <insert id="AddRolePermission" useGeneratedKeys="true"  keyProperty="id" parameterType="com.chengnianzhi.poweradmin_api.entity.RolePermission">
        INSERT INTO role_permission (role_id, permission_id, create_time, update_time)
        VALUES (#{roleId}, #{permissionId}, NOW(), NOW())
    </insert>
    <delete id="DeleteRolePermission" parameterType="com.chengnianzhi.poweradmin_api.entity.RolePermission">
        DELETE FROM role_permission
        <where>
            <if test="roleId != null and permissionId != null">
                AND role_id = #{roleId} AND permission_id = #{permissionId}
            </if>
        </where>
    </delete>
    <select id="getByRoleId" resultType="com.chengnianzhi.poweradmin_api.entity.RolePermission">
        SELECT *
        FROM role_permission
        WHERE role_id = #{roleId}
    </select>
    <select id="getByPermissionId" resultType="com.chengnianzhi.poweradmin_api.entity.RolePermission">
        SELECT *
        FROM role_permission
        WHERE permission_id = #{permissionId}
    </select>
</mapper>