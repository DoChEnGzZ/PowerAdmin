<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chengnianzhi.poweradmin_api.repository.UserMapper">
    <resultMap id="User" type="com.chengnianzhi.poweradmin_api.entity.UserEntity">
        <id column="uid" property="uid"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="nick_name" property="nickName"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
    <select id="getByUsername" resultMap="User">
        SELECT * FROM user WHERE username = #{username}
        LIMIT 1
    </select>
    <select id="getByUid" resultMap="User">
        SELECT * FROM user WHERE uid = #{uid}
        LIMIT 1
    </select>
</mapper>