<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chengnianzhi.poweradmin_api.repository.UserMapper">
    <select id="getByUsername" resultType="com.chengnianzhi.poweradmin_api.entity.UserEntity">
        SELECT * FROM user WHERE username = #{username}
        LIMIT 1
    </select>
</mapper>